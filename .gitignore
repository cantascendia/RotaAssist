# RotaAssist .gitignore

# === OS Files ===
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# === Editor / IDE ===
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# === Backup Files ===
*.bak
*.orig
*.tmp

# === Third-Party Libraries (manually managed) ===
addon/Libs/


# === Companion App (Phase 4) ===
companion/backend/__pycache__/
companion/backend/**/__pycache__/
companion/backend/*.pyc
companion/backend/.env
companion/backend/venv/
companion/frontend/node_modules/
companion/frontend/dist/
companion/frontend/.svelte-kit/

# === Build Artifacts ===
*.zip
*.tar.gz
release/
dist/

# === Logs ===
*.log

# v3.6 ai-playbook
.claude/agent-logs/*
!.claude/agent-logs/.gitkeep
docs/ai-cto/.codex-quota-cooldown
docs/ai-cto/.codex-bridge.lock

# CTO harness 升级备份（本地留存，不入库）
.claude/*.bak-*/

# === Local debug artifacts (CTO Round 15 cleanup) ===
/ci_failures*.log
/commits*.txt
/logs*.json
/run_log*.txt
